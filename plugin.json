{
  "id": "openai",
  "kind": "plugin",
  "version": "1.0.45",
  "label": "OpenAI",
  "description": "OpenAI API key + Codex coding agent for Settings \u2192 LLMs. Install from Store \u2192 Gateways, then enable to show OpenAI under Providers & Keys and Codex under Coding Agents.",
  "min_app_version": "1.2.45",
  "default_enabled": true,
  "secret_keys": [
    "openai"
  ],
  "contributes": {
    "llm.providers": [
      {
        "id": "openai",
        "label": "OpenAI",
        "kind": "secret",
        "secret_key": "openai",
        "order": 20
      }
    ],
    "llm.coding_agents": [
      {
        "id": "codex",
        "label": "Codex",
        "order": 100
      }
    ],
    "settings.sections": [
      {
        "tab": "LLMs",
        "id": "prompt-caching",
        "title": "OpenAI prompt caching",
        "description": "Bill-discount prefix caching markers on API calls. Separate from Ducky's freeze prefix (works for all providers).",
        "order": 81,
        "properties": [
          {
            "id": "promptCaching",
            "type": "boolean",
            "default": true,
            "label": "Enable OpenAI cache markers",
            "description": "Splits the stable system prefix so OpenAI can reuse cached input tokens across turns."
          }
        ]
      }
    ],
    "walkthrough": {
      "id": "openai",
      "title": "Set up OpenAI",
      "auto_start": "first_enable",
      "settings_tab": "LLMs",
      "steps": [
        {
          "target": "settings.llms.provider.openai",
          "title": "Open OpenAI",
          "body": "Press the OpenAI row in this table. The page slides open so you can paste a key or use Codex.",
          "advance": "require_click",
          "mode": "rect"
        },
        {
          "target": "settings.llms.provider.key",
          "title": "API key or Codex",
          "body": "Paste an OpenAI API key here to use GPT in Ducky chats. No key? Skip this and use Codex on this same slide \u2014 ChatGPT login is enough.",
          "advance": "next",
          "mode": "rect"
        },
        {
          "target": "settings.llms.provider.save",
          "title": "Test & Save",
          "body": "Press Test & Save after you paste a key. Using Codex without a key? Press Skip.",
          "advance": "require_click",
          "mode": "rect"
        },
        {
          "target": "settings.llms.provider.agent",
          "title": "Codex",
          "body": "Codex is OpenAI's coding agent. Detect finds the CLI (often under npm). Keep it on to pick Codex in chat.",
          "advance": "next",
          "mode": "rect"
        },
        {
          "target": "settings.llms.provider.agent.detect",
          "title": "Detect CLI",
          "body": "Press Detect to find Codex on this machine. Leave the toggle on so it appears in the chat picker.",
          "advance": "next",
          "mode": "rect"
        },
        {
          "target": "settings.llms.provider.plugin",
          "title": "OpenAI prompt caching",
          "body": "Cache markers let OpenAI reuse the stable system prefix across turns. Leave Enable OpenAI cache markers on to save input tokens.",
          "advance": "next",
          "mode": "rect"
        },
        {
          "target": "settings.llms.back",
          "title": "Back",
          "body": "Press Back to return to the provider list.",
          "advance": "require_click",
          "mode": "rect"
        }
      ]
    },
    "automations": {
      "nodes": [
        {
          "id": "openai.complete",
          "label": "OpenAI complete",
          "group": "OpenAI",
          "description": "One-shot prompt through the OpenAI gateway. Writes text onto the run.",
          "config_fields": [
            {
              "id": "prompt",
              "label": "Prompt",
              "type": "textarea"
            },
            {
              "id": "model",
              "label": "Model",
              "type": "model",
              "provider": "openai"
            }
          ]
        },
        {
          "id": "openai.image",
          "label": "OpenAI image",
          "group": "OpenAI",
          "description": "Generate an image with the OpenAI Images API.",
          "config_fields": [
            {
              "id": "prompt",
              "label": "Prompt",
              "type": "textarea"
            },
            {
              "id": "model",
              "label": "Model",
              "type": "select",
              "options": [
                {
                  "id": "gpt-image-1",
                  "label": "gpt-image-1"
                },
                {
                  "id": "dall-e-3",
                  "label": "dall-e-3"
                }
              ]
            },
            {
              "id": "size",
              "label": "Size",
              "type": "select",
              "options": [
                {
                  "id": "1024x1024",
                  "label": "1024\u00d71024"
                },
                {
                  "id": "1536x1024",
                  "label": "1536\u00d71024"
                },
                {
                  "id": "1024x1536",
                  "label": "1024\u00d71536"
                }
              ]
            },
            {
              "id": "quality",
              "label": "Quality",
              "type": "select",
              "options": [
                {
                  "id": "low",
                  "label": "low"
                },
                {
                  "id": "medium",
                  "label": "medium"
                },
                {
                  "id": "high",
                  "label": "high"
                }
              ]
            }
          ]
        }
      ],
      "templates": [
        {
          "id": "openai-complete",
          "label": "OpenAI complete",
          "icon": "\u2728",
          "systems": [
            "pipeline"
          ],
          "description": "Chat prompt through OpenAI, then finish.",
          "graph": {
            "nodes": [
              {
                "id": "s",
                "type": "start.chat",
                "x": 40,
                "y": 80,
                "config": {},
                "label": "Chat",
                "description": ""
              },
              {
                "id": "c",
                "type": "openai.complete",
                "x": 280,
                "y": 80,
                "config": {},
                "label": "Complete",
                "description": ""
              },
              {
                "id": "f",
                "type": "pipeline.finish",
                "x": 520,
                "y": 80,
                "config": {},
                "label": "Finish",
                "description": ""
              }
            ],
            "edges": [
              {
                "source": "s",
                "target": "c",
                "kind": "main"
              },
              {
                "source": "c",
                "target": "f",
                "kind": "main"
              }
            ]
          }
        }
      ]
    }
  },
  "backend": {
    "entry": "backend",
    "register": "register"
  }
}
